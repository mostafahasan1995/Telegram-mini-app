{
  "name": "ichancy-cashier-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram mini-app cashier backend for the Ichancy agent API (NSP)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev:api": "cross-env APP_ROLE=api nest start --watch",
    "dev:worker": "cross-env APP_ROLE=worker nest start --watch --entryFile main.worker --path tsconfig.worker.json",
    "build": "nest build -p tsconfig.build.json",
    "start:api": "cross-env APP_ROLE=api node dist/main.js",
    "start:worker": "cross-env APP_ROLE=worker node dist/main.worker.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:int": "jest --config jest-int.config.cjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:bootstrap": "ts-node -r tsconfig-paths/register scripts/db-bootstrap.ts",
    "db:setup": "prisma migrate dev --name init && npm run db:bootstrap && npm run seed",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register prisma/seed.ts",
    "webhook:set": "cross-env APP_ROLE=api ts-node -r tsconfig-paths/register src/main.cli.ts webhook:set"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "@aws-sdk/lib-storage": "^3.888.0",
    "@aws-sdk/s3-request-presigner": "^3.888.0",
    "@grammyjs/auto-retry": "^2.0.2",
    "@nestjs/bullmq": "^11.0.3",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bullmq": "^5.58.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "grammy": "^1.38.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "nanoid": "^3.3.11",
    "nest-commander": "^3.19.0",
    "nestjs-pino": "^4.4.1",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.3",
    "uuidv7": "^1.0.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.8",
    "@nestjs/testing": "^11.1.6",
    "@testcontainers/postgresql": "^11.5.1",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "cross-env": "^7.0.3",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^5.0.2",
    "jest": "^30.0.5",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.6.2",
    "prisma": "^7.0.0",
    "supertest": "^7.1.4",
    "testcontainers": "^11.5.1",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  }
}
