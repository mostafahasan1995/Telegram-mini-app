# =============================================================================
# ichancy-cashier-backend — environment
# Copy to .env and fill in. Boot FAILS LOUDLY (zod) if anything below is missing
# or malformed, see src/core/config/env.schema.ts.
# =============================================================================

# -----------------------------------------------------------------------------
# APP
# APP_ROLE selects the entrypoint behaviour from ONE image:
#   api    -> HTTP server only. NEVER signs in to Ichancy, reads tokens from Redis.
#   worker -> schedules, BullMQ processors, outbox relay, and the ONLY process
#             allowed to run Ichancy signin/refreshToken (one token pair per agent).
# -----------------------------------------------------------------------------
APP_ROLE=api
NODE_ENV=development
PORT=3000
# Public origin of this API, used to build webhook + presigned callback URLs.
API_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL 17)
# The app must connect as a NON-OWNER role so prisma/sql/003_app_role_grants.sql
# can actually revoke UPDATE/DELETE on the ledger tables (owners bypass grants).
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://ichancy_app:ichancy_app@localhost:5432/ichancy?schema=public
DB_POOL_MAX=10

# Schema OWNER connection. Used by `prisma migrate` and by `npm run db:bootstrap`, which creates the
# restricted role above (matching DATABASE_URL exactly) and applies prisma/sql/001..005.
# docker-compose provisions this owner as ichancy/ichancy. Leave it unset ONLY for throwaway local
# work: without a separate owner, 003_app_role_grants.sql cannot revoke anything, because a table
# owner keeps implicit privileges no matter what you REVOKE.
MIGRATE_DATABASE_URL=postgresql://ichancy:ichancy@localhost:5432/ichancy?schema=public

# -----------------------------------------------------------------------------
# REDIS 7 (BullMQ queues, Ichancy session store, distributed locks)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# AUTH (mini-app player sessions + admin panel)
# JWT_ACCESS_TTL accepts a duration string understood by @nestjs/jwt (e.g. 15m, 1h).
# -----------------------------------------------------------------------------
JWT_SECRET=change_me_to_a_random_string_of_at_least_32_chars
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# -----------------------------------------------------------------------------
# TELEGRAM
# TELEGRAM_WEBHOOK_SECRET  -> value we set as secret_token; compared against the
#                             X-Telegram-Bot-Api-Secret-Token header on every update.
# TELEGRAM_WEBHOOK_PATH_TOKEN -> random path segment so the endpoint is unguessable.
# TELEGRAM_ADMIN_CHAT_ID   -> group/supergroup that receives deposit review cards
#                             (negative id for supergroups, e.g. -1001234567890).
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
TELEGRAM_WEBHOOK_SECRET=change_me_random_32_chars_minimum
TELEGRAM_WEBHOOK_PATH_TOKEN=change_me_random_url_safe_token
TELEGRAM_ADMIN_CHAT_ID=-1001234567890

# -----------------------------------------------------------------------------
# TELEGRAM FEED GROUP (OPTIONAL) — the "شحن" wall customers can be shown
#
# TELEGRAM_FEED_CHAT_ID -> a SECOND group that also receives the credited-deposit
#   card ("عملية شحن على المنصة"). Same shape as TELEGRAM_ADMIN_CHAT_ID: a negative
#   supergroup id. Leave it EMPTY or delete the line to switch the feature off —
#   nothing is then posted anywhere but the admin group.
#
# READ THIS BEFORE SETTING IT. The feed group is assumed to contain CUSTOMERS, so
# the card that goes there is the MASKED one:
#   * رصيد الكاشيرة قبل/بعد الشحن is REMOVED, not hidden. That is our working
#     capital: it tells a competitor what we can pay out and tells a fraudster
#     when we are too thin to absorb a loss.
#   * the player's Telegram id, Ichancy login and Ichancy player id are cut to
#     their last few characters (•••785) — enough for a player to recognise their
#     own credit, useless to anyone else. A raw Telegram id is a link to a profile.
# What stays: the amount, the payment method, the reference and the time.
#
# TELEGRAM_FEED_FULL_DETAIL -> set to true ONLY if that group is staff-only. It
#   posts the FULL admin card (float + identifiers) to the feed instead. Accepts
#   true/false, 1/0, yes/no, on/off. Unset or empty = false = masked, because the
#   default has to be the one that leaks nothing when the chat id is mistyped.
#
# Float warnings and ledger-invariant alerts NEVER go to the feed, whatever these
# two are set to. Those are internal ops signals and stay admin-only.
# -----------------------------------------------------------------------------
TELEGRAM_FEED_CHAT_ID=
TELEGRAM_FEED_FULL_DETAIL=false

# -----------------------------------------------------------------------------
# SCHEDULED ACTIVITY REPORT
#
# REPORT_SCHEDULE_HOURS -> how often the WORKER posts the /report activity report
#   by itself, in whole hours, 1..168 (a week). Deleting the line falls back to
#   the default of 6. Set 0 — or leave the value EMPTY — to switch the schedule
#   off; typing /report by hand keeps working either way.
#
# WHERE IT IS POSTED: the FEED group (TELEGRAM_FEED_CHAT_ID) when one is
# configured, and the ADMIN group when there is none. It is never silent just
# because the optional feed group is unset — a single-group setup still gets its
# report. The message is prefixed "🕒 تقرير دوري" so nobody mistakes it for a
# report an admin just ran.
#
# READ THIS BEFORE POINTING IT AT A FEED GROUP: the report body includes
# رصيد الكاشيرة — the ICHANCY_AGENT_FLOAT balance. That is the working-capital
# figure the masked feed card above deliberately REMOVES, for the reasons spelled
# out there. If your feed group contains customers, either leave
# TELEGRAM_FEED_CHAT_ID unset (the report then goes to the admin group) or set
# REPORT_SCHEDULE_HOURS=0 and run /report by hand.
#
# Timing is accurate to ten minutes: the worker wakes on a fixed short tick and a
# Redis marker decides which wake-up posts, so a restart neither re-posts nor
# resets the schedule and two workers cannot both post.
# -----------------------------------------------------------------------------
REPORT_SCHEDULE_HOURS=6

# Comma-separated list of allowed mini-app origins (CORS + initData origin check).
MINI_APP_ORIGIN=https://app.example.com

# -----------------------------------------------------------------------------
# ICHANCY AGENT API
# Only ONE accessToken/refreshToken pair is valid per agent at a time and a second
# signIn kills the first, so ONLY the worker role may use these credentials.
# ICHANCY_AGENT_ID is the affiliateId used as parentId when registering players.
# -----------------------------------------------------------------------------
ICHANCY_BASE_URL=https://agent.example.com
ICHANCY_USERNAME=agent_username
ICHANCY_PASSWORD=agent_password
ICHANCY_AGENT_ID=1234567
ICHANCY_CURRENCY=NSP
ICHANCY_TIMEOUT_MS=8000

# ICHANCY_PLAYER_EMAIL_DOMAIN -> domain of the synthetic mailboxes we register
#   players with:  p912911246_7fszgwgh@players.example.com
#
#   MUST use a TLD Ichancy accepts. This project used RFC 2606's `.invalid`
#   (reserved so it can NEVER resolve — the ideal choice for an address that must
#   not deliver) and the live API refused it on 2026-08-19 with
#       "Email field contains invalid characters."
#   Probing proved the TLD was the only cause: the same local part on `.com` was
#   accepted, and the underscore, digits and hyphen were all fine.
#
#   MUST be a domain nobody else can ever own. Ichancy may send account mail to
#   these addresses, so a domain you do not control means a stranger receiving
#   your players' email one registration later. Use either:
#     * a domain you own, with NO MX record (mail bounces), or
#     * example.com — IANA holds it permanently under RFC 2606 (the default)
#
#   ⚠️ PERMANENT PER PLAYER: the address is stored on the row and is unique
#   upstream. Changing this only affects players registered AFTERWARDS. Decide
#   once, before the first real registration.
ICHANCY_PLAYER_EMAIL_DOMAIN=players.example.com

# ICHANCY_PLAYER_SITE_URL -> the PLAYER-facing site, printed in the bot's /account
#   message. Never the agent panel (ICHANCY_BASE_URL): that is staff-only.
ICHANCY_PLAYER_SITE_URL=https://ichancy.com

# -----------------------------------------------------------------------------
# CLOUDFLARE (agents.ichancy.com is behind bot protection)
#
# THE SYMPTOM: it works in the browser, and Postman / this backend get an HTML
# challenge page instead of JSON. That is Cloudflare, not Ichancy, and no amount
# of re-authenticating fixes it — the call never reaches the agent API.
# The backend reports it as CLOUDFLARE_CHALLENGE in ichancy_calls.error_code and
# in the logs, and `npm run ichancy:check` prints it with the fix.
#
# ICHANCY_COOKIE -> the raw Cookie header. Open agents.ichancy.com in a browser,
#   log in, then DevTools > Application > Cookies and copy at least cf_clearance,
#   plus __cf_bm and the PHPSESSID_... pair. One line, semicolon separated:
#     ICHANCY_COOKIE=cf_clearance=abc...; __cf_bm=def...; PHPSESSID_x=ghi...
#
# ICHANCY_USER_AGENT -> MUST be the User-Agent of the browser that produced that
#   cf_clearance. Cloudflare binds the clearance to the UA; a mismatch fails just
#   like no cookie at all. Copy it from DevTools > Network > any request.
#
# ⚠️ THE PART THAT BITES: cf_clearance is ALSO bound to the PUBLIC IP that earned
#   it. A cookie copied from your laptop will not work from a server on a
#   different IP. Options, best first:
#     1. Ask Ichancy to allowlist the server's IP — then no cookie is needed and
#        both of these can stay empty. This is the only durable answer.
#     2. Earn the cookie from the server's own IP (a browser on that host, or a
#        proxy that egresses through it) and paste it here.
#     3. Re-paste a fresh cookie whenever it expires. __cf_bm lasts ~30 minutes,
#        cf_clearance longer. This is a stopgap, not an operating model.
#
# Both are OPTIONAL: a host without bot protection, and ICHANCY_FAKE=true, need
# neither.
# -----------------------------------------------------------------------------
ICHANCY_COOKIE=
ICHANCY_USER_AGENT=

# -----------------------------------------------------------------------------
# OBJECT STORAGE (deposit proof images) — S3 compatible (MinIO in docker-compose)
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=deposit-proofs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# BUSINESS LIMITS — all *_MINOR values are integer minor units of NSP (scale 2),
# i.e. 500000000 = 5,000,000.00 NSP. Never a decimal here.
# DUAL_APPROVAL_THRESHOLD_MINOR   -> at or above this, a deposit needs a second,
#                                    different admin (enforced by 005_four_eyes_check.sql).
# DEPOSIT_EXPIRY_MINUTES          -> unpaid/unproven deposits are auto-EXPIRED after this.
# AGENT_FLOAT_LOW_WATERMARK_MINOR -> warn/refuse approvals when our Ichancy agent
#                                    float drops below this.
# -----------------------------------------------------------------------------
DUAL_APPROVAL_THRESHOLD_MINOR=100000000
DEPOSIT_EXPIRY_MINUTES=120
AGENT_FLOAT_LOW_WATERMARK_MINOR=50000000
