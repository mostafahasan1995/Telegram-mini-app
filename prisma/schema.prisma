// =============================================================================
// ichancy-cashier — data model
//
// Design rules that this schema encodes (read before changing anything):
//  1. Money is ALWAYS a BigInt column named *Minor, in the currency's minor units. There is no
//     Decimal, no Float, no Numeric anywhere. Currency.scale is frozen at seed time.
//  2. The ledger is append-only. ledger_transactions / ledger_entries / audit_logs are protected by
//     triggers (prisma/sql/002) and grants (prisma/sql/003); Prisma can insert but must never
//     update or delete them.
//  3. Double entry: the signed sum of ledger_entries.amount_minor per (transaction, currency) is 0,
//     enforced by a DEFERRABLE constraint trigger (prisma/sql/001) so multi-row inserts are legal
//     inside one transaction.
//  4. The Ichancy API has no idempotency key and no lookup-by-reference. Everything we need to
//     reconstruct "did the money move?" lives here: ichancy_calls records EVERY attempt, and
//     deposit_requests keeps the balance readings that justified a BALANCE_DELTA verification.
//  5. Everything a human claims and everything we verified are SEPARATE columns
//     (claimedAmountMinor vs verifiedAmountMinor). We never overwrite the claim.
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

// Prisma 7 no longer accepts `url` here: the CLI reads the connection string from prisma.config.ts,
// and PrismaClient gets a @prisma/adapter-pg instance so the pool is ours to configure (DB_POOL_MAX).
datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum PlayerStatus {
  /// Registered with us, not yet mirrored into Ichancy (registerPlayer not confirmed).
  PENDING_ICHANCY
  ACTIVE
  SUSPENDED
  SELF_EXCLUDED
  CLOSED

  @@map("player_status")
}

/// Which door a player came in through (dashboard API-CONTRACT.md, "Players that were never a
/// Telegram account").
enum PlayerSource {
  /// A Telegram account that pressed Start. Every row written before this enum existed.
  TELEGRAM
  /// An account that already existed under the operator's Ichancy agent, pulled in by the import.
  ICHANCY_IMPORT
  /// A row registered from the console.
  ADMIN

  @@map("player_source")
}

enum AdminRole {
  /// Platform staff. Lives ONLY in tenant zero (enforced by a CHECK constraint) and is the
  /// only role whose X-Tenant-Id header is honoured. The owner superset (dashboard
  /// API-CONTRACT.md §3): it passes every role list and is unbounded by approval limits, but
  /// four-eyes still applies above the dual-approval threshold. See core/auth/admin-authority.ts.
  PLATFORM_ADMIN
  SUPER_ADMIN
  FINANCE_ADMIN
  REVIEWER
  SUPPORT
  VIEWER

  @@map("admin_role")
}

enum ActorType {
  PLAYER
  ADMIN
  SYSTEM

  @@map("actor_type")
}

enum PaymentRail {
  BANK_TRANSFER
  MOBILE_WALLET
  CASH_OFFICE
  CRYPTO
  /// Internal corrections / float top-ups that did not arrive over a real rail.
  INTERNAL

  @@map("payment_rail")
}

enum VerificationMode {
  /// A human reads the uploaded proof image.
  MANUAL_PROOF
  /// Player types the rail's reference and we match it against a statement/whitelist.
  REFERENCE_MATCH
  /// Automated statement ingestion (future rails).
  AUTO_STATEMENT
  NONE

  @@map("verification_mode")
}

enum DepositStatus {
  DRAFT
  AWAITING_PROOF
  SUBMITTED
  UNDER_REVIEW
  PENDING_SECOND_APPROVAL
  APPROVED
  /// Handed to the credit worker; a per-player mutex is held from here until CREDITED/failed.
  CREDITING
  CREDITED
  /// Ichancy explicitly rejected the credit. No ledger movement happened.
  CREDIT_FAILED
  /// Ambiguous outcome we could not resolve by balance delta. A human must look at Ichancy.
  NEEDS_RECONCILIATION
  REJECTED
  EXPIRED
  REVERSED

  @@map("deposit_status")
}

enum RejectionCode {
  DUPLICATE_PROOF
  PROOF_UNREADABLE
  PROOF_MISSING
  AMOUNT_MISMATCH
  REFERENCE_NOT_FOUND
  WRONG_DESTINATION
  SENDER_MISMATCH
  SUSPECTED_FRAUD
  LIMIT_EXCEEDED
  PLAYER_INELIGIBLE
  EXPIRED
  OTHER

  @@map("rejection_code")
}

enum ProofSource {
  PLAYER_UPLOAD
  ADMIN_UPLOAD
  TELEGRAM_PHOTO
  TELEGRAM_DOCUMENT
  SYSTEM_IMPORT

  @@map("proof_source")
}

enum LedgerAccountKind {
  /// Money in transit on a payment rail before we confirm it (one per payment method).
  RAIL_CLEARING
  /// Our own confirmed cash.
  HOUSE_CASH
  /// What we owe a player who has paid us but is not credited yet (one per player).
  PLAYER_LIABILITY
  /// Our finite balance inside the Ichancy agent panel; synced from getAgentAllWallets.
  ICHANCY_AGENT_FLOAT
  /// Mirror of what we believe a player holds inside Ichancy (one per player).
  CASINO_MIRROR
  /// Receipts we cannot attribute to any deposit yet.
  SUSPENSE_UNIDENTIFIED
  /// Absorbs sub-minor-unit differences so every transaction can balance to exactly 0.
  HOUSE_ROUNDING

  @@map("ledger_account_kind")
}

enum LedgerTxKind {
  /// T1: player claims a payment; rail clearing -> player liability.
  DEPOSIT_CLAIM
  /// T2: we credited Ichancy; player liability -> casino mirror / agent float.
  DEPOSIT_CREDIT
  DEPOSIT_REVERSAL
  /// We pushed our own money into the Ichancy agent wallet.
  AGENT_FLOAT_TOPUP
  /// Correction posted after comparing our float account with getAgentAllWallets.
  AGENT_FLOAT_SYNC
  FEE
  ROUNDING
  MANUAL_ADJUSTMENT
  RECONCILIATION_WRITEOFF

  @@map("ledger_tx_kind")
}

enum IchancyOperation {
  SIGNIN
  REFRESH_TOKEN
  GET_AGENT_ALL_WALLETS
  DEPOSIT_TO_AGENT
  WITHDRAW_FROM_AGENT
  GET_CHILDREN
  REGISTER_PLAYER
  GET_PLAYERS_FOR_CURRENT_AGENT
  DEPOSIT_TO_PLAYER
  WITHDRAW_FROM_PLAYER
  GET_PLAYER_BALANCE_BY_ID

  @@map("ichancy_operation")
}

enum IchancyOutcome {
  /// status true, no error notification, result not false.
  OK
  /// A definite business "no" (HTTP 422, or status:true + an error notification).
  REJECTED
  /// HTTP 201/401/403 or an "unauthorized / invalid or expired refresh" notification.
  TOKEN_EXPIRED
  /// We do not know whether the money moved. Only balance re-reads can settle this.
  AMBIGUOUS
  TIMEOUT
  TRANSPORT_ERROR

  @@map("ichancy_outcome")
}

enum OutboxStatus {
  PENDING
  IN_FLIGHT
  SENT
  FAILED
  /// Gave up after max attempts; needs a human.
  DEAD

  @@map("outbox_status")
}

enum BreakCategory {
  AGENT_FLOAT_MISMATCH
  PLAYER_BALANCE_MISMATCH
  MISSING_CREDIT
  DUPLICATE_CREDIT
  UNIDENTIFIED_RECEIPT
  LEDGER_IMBALANCE
  ORPHAN_ICHANCY_CALL
  STUCK_DEPOSIT

  @@map("break_category")
}

enum BreakStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  WRITTEN_OFF
  FALSE_POSITIVE

  @@map("break_status")
}

/// How we became convinced a credit actually landed. BALANCE_DELTA means the API answer was
/// ambiguous and we proved it by re-reading getPlayerBalanceById.
enum CreditVerifiedBy {
  API_OK
  BALANCE_DELTA
  MANUAL

  @@map("credit_verified_by")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  /// Closed operators keep their rows. Money history is never deleted, only stopped.
  CLOSED

  @@map("tenant_status")
}

/// How an operator's bot answers a submitted deposit. MANUAL is the safe default everywhere: a
/// missing setting must never auto-credit money.
enum DepositMode {
  AUTO
  MANUAL

  @@map("deposit_mode")
}

/// How an operator's bot answers a cash-out. Same defaulting rule as DepositMode.
enum WithdrawalMode {
  AUTO
  MANUAL

  @@map("withdrawal_mode")
}

/// What kind of chat the bot was seen in. There is no PRIVATE member: a one-to-one chat is never
/// somewhere an operator's staff or feed is bound, so a private chat is never recorded at all.
enum TelegramChatType {
  GROUP
  SUPERGROUP
  CHANNEL

  @@map("telegram_chat_type")
}

/// The bot's own membership in a chat, in Telegram's vocabulary. Kept whole rather than collapsed
/// into a boolean because each value is fixed by a different person doing a different thing.
enum TelegramBotChatStatus {
  CREATOR
  ADMINISTRATOR
  MEMBER
  RESTRICTED
  LEFT
  KICKED

  @@map("telegram_bot_chat_status")
}

/// Which of an operator's two chats a binding is for: the staff group (`tenants.admin_chat_id`, review
/// cards and alerts) or the feed group (`tenants.feed_chat_id`, the customer-facing mirror).
enum TelegramChatPurpose {
  STAFF
  FEED

  @@map("telegram_chat_purpose")
}

// =============================================================================
// TENANCY
// =============================================================================

/// An operator. Every row in a tenant-scoped table belongs to exactly one of these.
///
/// TENANT ZERO is the platform's own operator (see TENANT_ZERO_ID in src/core/tenant). It exists
/// so that PLATFORM_ADMIN rows have somewhere to live that is not an operator: a platform login
/// sitting inside a customer's tenant is a tenant login holding platform authority, which is why
/// prisma/sql/006 refuses to write one.
///
/// SECRETS: botToken, the webhook secret, the Ichancy password and the Sham Cash key are sealed
/// with the AES secret box and are never returned by any endpoint. The webhook path token is
/// reported only as `hasWebhookPath`.
model Tenant {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// URL-safe identity, slugify(displayName) de-duplicated with -2, -3 … on collision.
  /// Immutable after creation: it is how operators are named in logs and support tickets.
  slug        String       @unique
  displayName String       @map("display_name")
  /// A new operator lands SUSPENDED on purpose. Nothing can verify from a form that the agent id
  /// is the right one, so activating is a second, deliberate act that does a real Ichancy signin.
  status      TenantStatus @default(SUSPENDED)

  // ---- Telegram ----------------------------------------------------------------------------
  botTokenEnc      String  @map("bot_token_enc")
  /// Filled from getMe when the token is accepted; null until the bot has answered once.
  botUsername      String? @map("bot_username")
  /// The bot's public Telegram user id, from getMe, the number a token starts with. Unique because
  /// Telegram keeps exactly one webhook per bot: two operators on one bot would take each other's
  /// deliveries, and each re-registration would silently move the other's players. Nullable only for
  /// rows written before this column existed, whose token is sealed and cannot be read in SQL.
  botId            BigInt? @unique @map("bot_id")
  /// CSPRNG path segment the webhook is registered under. Unique across operators because it is
  /// what routes an inbound update to THIS tenant before any other identity exists.
  webhookPathToken String? @unique @map("webhook_path_token")
  /// Telegram's X-Telegram-Bot-Api-Secret-Token for this operator, sealed.
  webhookSecretEnc String? @map("webhook_secret_enc")
  /// The staff group: where this operator's review cards and alerts go. 0 means no staff group is
  /// bound yet (Telegram has no chat 0), which is how an operator is created, and such an operator
  /// cannot be activated. Only a chat the bot has just been verified in is ever written here.
  adminChatId      BigInt  @map("admin_chat_id")
  feedChatId       BigInt? @map("feed_chat_id")

  // ---- Ichancy -----------------------------------------------------------------------------
  ichancyBaseUrl     String @map("ichancy_base_url")
  ichancyUsername    String @map("ichancy_username")
  ichancyPasswordEnc String @map("ichancy_password_enc")
  /// Never derivable: Ichancy signin() returns only a token pair. Supplied -> PlatformDefaults ->
  /// tenant zero's -> 400. Two operators MAY share one agent id; that is how a second is tested.
  ichancyAgentId     String @map("ichancy_agent_id")

  // ---- Money settings, copied from PlatformDefaults at creation and owned by the row after ----
  currencyCode                String         @map("currency_code") @db.VarChar(3)
  dualApprovalThresholdMinor  BigInt         @map("dual_approval_threshold_minor")
  agentFloatLowWatermarkMinor BigInt         @map("agent_float_low_watermark_minor")
  depositExpiryMinutes        Int            @map("deposit_expiry_minutes")
  depositMode                 DepositMode    @default(MANUAL) @map("deposit_mode")
  withdrawalMode              WithdrawalMode @default(MANUAL) @map("withdrawal_mode")
  /// The https URL the bot's "open the app" button opens. Null is "not set yet".
  miniAppUrl                  String?        @map("mini_app_url")

  // ---- Sham Cash (columns land here in phase 1 so the rail has somewhere to go) --------------
  shamcashWalletId  String? @map("shamcash_wallet_id")
  shamcashApiKeyEnc String? @map("shamcash_api_key_enc")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  currency Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  paymentMethods       PaymentMethod[]
  paymentDestinations  PaymentDestination[]
  players              Player[]
  playerSessions       PlayerSession[]
  adminUsers           AdminUser[]
  adminApprovalLimits  AdminApprovalLimit[]
  depositRequests      DepositRequest[]
  depositProofs        DepositProof[]
  depositTransitions   DepositTransition[]
  ledgerAccounts       LedgerAccount[]
  ledgerTransactions   LedgerTransaction[]
  ledgerEntries        LedgerEntry[]
  outboxMessages       OutboxMessage[]
  idempotencyKeys      IdempotencyKey[]
  telegramUpdates      TelegramUpdate[]
  telegramDiscoveredChats TelegramDiscoveredChat[]
  telegramChatBindLinks   TelegramChatBindLink[]
  adminTelegramLinkCodes  AdminTelegramLinkCode[]
  ichancyCalls         IchancyCall[]
  auditLogs            AuditLog[]
  reconciliationBreaks ReconciliationBreak[]
  playerLimits         PlayerLimit[]
  selfExclusions       SelfExclusion[]

  @@index([status])
  @@map("tenants")
}

/// The single settings row a NEW operator inherits from. Editing it changes what the next operator
/// gets and does NOT reach back into existing ones — their values were copied onto their own rows.
///
/// Singleton: `id` is pinned to 1 by a CHECK constraint (prisma/sql/006), so there is exactly one
/// row to read and no "which defaults were in force" ambiguity.
model PlatformDefaults {
  id Int @id @default(1)

  ichancyBaseUrl String  @map("ichancy_base_url")
  /// The house agent. Nullable because a platform that has not named one genuinely has none, and
  /// an agent id can never be derived from credentials.
  ichancyAgentId String? @map("ichancy_agent_id")

  currencyCode                String @map("currency_code") @db.VarChar(3)
  dualApprovalThresholdMinor  BigInt @map("dual_approval_threshold_minor")
  agentFloatLowWatermarkMinor BigInt @map("agent_float_low_watermark_minor")
  depositExpiryMinutes        Int    @map("deposit_expiry_minutes")

  /// When PlatformDefaultsService copied this deployment's env values over the migration's
  /// literals. NULL means "never seeded": the first read seeds and stamps it, exactly once, so an
  /// existing deployment keeps the values its .env already had without anybody running a script.
  seededFromEnvAt DateTime? @map("seeded_from_env_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_defaults")
}

// =============================================================================
// REFERENCE DATA
// =============================================================================

model Currency {
  code      String   @id @db.VarChar(3)
  name      String
  /// Number of decimal digits in the minor unit. FROZEN at seed: changing it invalidates every
  /// *Minor column ever written.
  scale     Int
  symbol    String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenants              Tenant[]
  players              Player[]
  paymentMethods       PaymentMethod[]
  depositRequests      DepositRequest[]
  ledgerAccounts       LedgerAccount[]
  ledgerTransactions   LedgerTransaction[]
  ledgerEntries        LedgerEntry[]
  adminApprovalLimits  AdminApprovalLimit[]
  playerLimits         PlayerLimit[]
  reconciliationBreaks ReconciliationBreak[]

  @@map("currencies")
}

model PaymentMethod {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  /// Stable machine code used by the mini-app and by seeds, e.g. SYRIATEL_CASH.
  code             String
  displayName      String           @map("display_name")
  rail             PaymentRail
  currencyCode     String           @map("currency_code") @db.VarChar(3)
  verificationMode VerificationMode @map("verification_mode")
  isActive         Boolean          @default(true) @map("is_active")
  sortOrder        Int              @default(0) @map("sort_order")

  minAmountMinor BigInt @map("min_amount_minor")
  maxAmountMinor BigInt @map("max_amount_minor")
  /// Fee we keep, charged as fixed + bps of the claimed amount. Posted to HOUSE_CASH via a FEE tx.
  feeFixedMinor  BigInt @default(0) @map("fee_fixed_minor")
  feeBps         Int    @default(0) @map("fee_bps")

  /// Player must supply the rail's own reference (bank txn id, wallet receipt no).
  requiresReference Boolean @default(false) @map("requires_reference")
  /// Optional regex the reference must match before we accept the submission.
  referencePattern  String? @map("reference_pattern")
  /// Free-text shown in the mini-app ("send to the number below, then upload the receipt").
  instructions      String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  currency        Currency             @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  destinations    PaymentDestination[]
  depositRequests DepositRequest[]
  ledgerAccounts  LedgerAccount[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, isActive, sortOrder])
  @@index([tenantId, currencyCode])
  @@index([tenantId])
  @@map("payment_methods")
}

model PaymentDestination {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String  @map("tenant_id") @db.Uuid
  paymentMethodId   String  @map("payment_method_id") @db.Uuid
  label             String
  /// The account/number/address the player actually pays into.
  accountIdentifier String  @map("account_identifier")
  accountHolder     String? @map("account_holder")
  isActive          Boolean @default(true) @map("is_active")
  /// Lower = offered first. Lets us rotate destinations without deactivating them.
  priority          Int     @default(0)
  /// Soft cap used by the rotation logic to spread volume; not a hard constraint.
  dailyCapMinor     BigInt? @map("daily_cap_minor")
  notes             String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  paymentMethod   PaymentMethod    @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  depositRequests DepositRequest[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([paymentMethodId, accountIdentifier])
  @@index([tenantId, paymentMethodId, isActive, priority])
  @@index([tenantId])
  @@map("payment_destinations")
}

// =============================================================================
// PEOPLE
// =============================================================================

model Player {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  /// Telegram ids are 64-bit; storing them as BigInt avoids the 2^53 trap. Null only for a player
  /// that was never a Telegram account (an ICHANCY_IMPORT row), until one is attached.
  telegramUserId   BigInt?      @map("telegram_user_id")
  telegramUsername String?      @map("telegram_username")
  firstName        String?      @map("first_name")
  lastName         String?      @map("last_name")
  languageCode     String?      @map("language_code")
  phone            String?
  status           PlayerStatus @default(PENDING_ICHANCY)
  source           PlayerSource @default(TELEGRAM)
  currencyCode     String       @default("NSP") @map("currency_code") @db.VarChar(3)

  /// registerPlayer returns the number 1, NOT an id — this is resolved afterwards through
  /// getPlayersForCurrentAgent(userName=...). Null means the mirror does not exist yet.
  ichancyPlayerId     String?   @map("ichancy_player_id")
  /// Credentials we generate at registration time and keep, because the player never sees them.
  ichancyLogin        String?   @map("ichancy_login")
  ichancyEmail        String?   @map("ichancy_email")
  /// Encrypted at rest; never leaves the backend and is never returned by any API.
  ichancyPasswordEnc  String?   @map("ichancy_password_enc")
  ichancyRegisteredAt DateTime? @map("ichancy_registered_at") @db.Timestamptz(6)

  /// Bookkeeping for the worker-only registration backfill (PlayerLinkBackfillService).
  ///
  /// WHY THESE ARE COLUMNS AND NOT REDIS KEYS: losing the backoff on a restart means re-hammering
  /// rows Ichancy has permanently refused, which drives the IP's Cloudflare trust score down —
  /// the exact mechanism that turned twenty minutes of failure into hours on 2026-08-20. An
  /// operator also has to be able to read "attempt 7, last error CLOUDFLARE_CHALLENGE" off the row
  /// while diagnosing. All four are nullable/defaulted, so no existing write path changes.
  ichancyLinkAttempts      Int       @default(0) @map("ichancy_link_attempts")
  ichancyLinkLastAttemptAt DateTime? @map("ichancy_link_last_attempt_at") @db.Timestamptz(6)
  ichancyLinkNextAttemptAt DateTime? @map("ichancy_link_next_attempt_at") @db.Timestamptz(6)
  ichancyLinkLastError     String?   @map("ichancy_link_last_error")

  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  currency             Currency              @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  sessions             PlayerSession[]
  depositRequests      DepositRequest[]
  ledgerAccounts       LedgerAccount[]
  limits               PlayerLimit[]
  selfExclusions       SelfExclusion[]
  ichancyCalls         IchancyCall[]
  reconciliationBreaks ReconciliationBreak[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, telegramUserId])
  @@unique([tenantId, ichancyPlayerId])
  @@unique([tenantId, ichancyLogin])
  @@unique([tenantId, ichancyEmail])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  /// The backfill's selector: PENDING_ICHANCY rows whose next attempt is due.
  @@index([tenantId, status, ichancyLinkNextAttemptAt])
  @@index([tenantId])
  @@map("players")
}

model PlayerSession {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String @map("tenant_id") @db.Uuid
  playerId         String @map("player_id") @db.Uuid
  /// Only the hash is stored, so a database dump cannot be replayed as a session.
  refreshTokenHash String @unique @map("refresh_token_hash")

  issuedAt            DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// Set when this session was rotated; makes refresh-token reuse detectable.
  replacedBySessionId String?   @unique @map("replaced_by_session_id") @db.Uuid

  ip               String?   @db.Inet
  userAgent        String?   @map("user_agent")
  /// auth_date from Telegram initData, kept to audit stale logins.
  telegramAuthDate DateTime? @map("telegram_auth_date") @db.Timestamptz(6)

  player            Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  replacedBySession PlayerSession? @relation("SessionRotation", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  replacesSession   PlayerSession? @relation("SessionRotation")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, playerId, expiresAt])
  @@index([tenantId])
  @@map("player_sessions")
}

model AdminUser {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  /// Null for a console-only account (username + password). Only a non-null id can work the bot,
  /// and it is never how an HTTP request identifies an admin: access tokens carry (tid, sub = id).
  /// Several NULLs coexist under @@unique([tenantId, telegramUserId]) — Postgres treats NULLs as
  /// distinct — and a NULL never equals any Telegram id a lookup can pass.
  telegramUserId BigInt?   @map("telegram_user_id")
  /// Console login. Lower-cased on write, so uniqueness per tenant is case-insensitive in practice.
  username       String?
  displayName    String    @map("display_name")
  role           AdminRole
  isActive       Boolean   @default(true) @map("is_active")
  /// Console password as a self-describing scrypt string (`$scrypt$ln=..,r=..,p=..$salt$hash`).
  /// Written and checked ONLY through PasswordHasherService; never selected into a view.
  passwordHash   String?   @map("password_hash")
  totpSecretEnc  String?   @map("totp_secret_enc")
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  approvalLimits         AdminApprovalLimit[]
  decidedDeposits        DepositRequest[]      @relation("DepositDecidedBy")
  secondApprovedDeposits DepositRequest[]      @relation("DepositSecondApprover")
  assignedBreaks         ReconciliationBreak[] @relation("BreakAssignee")
  resolvedBreaks         ReconciliationBreak[] @relation("BreakResolver")
  revokedSelfExclusions  SelfExclusion[]       @relation("SelfExclusionRevoker")
  telegramLinkCodes      AdminTelegramLinkCode[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, telegramUserId])
  @@unique([tenantId, username])
  @@index([tenantId, role, isActive])
  @@index([tenantId])
  @@map("admin_users")
}

model AdminApprovalLimit {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  adminUserId  String @map("admin_user_id") @db.Uuid
  currencyCode String @map("currency_code") @db.VarChar(3)

  maxSingleApprovalMinor   BigInt  @map("max_single_approval_minor")
  maxDailyApprovalMinor    BigInt  @map("max_daily_approval_minor")
  /// Per-admin override of DUAL_APPROVAL_THRESHOLD_MINOR; null falls back to the env value.
  secondApprovalAboveMinor BigInt? @map("second_approval_above_minor")

  /// Limits are versioned rather than mutated, so an old decision can always be re-justified.
  effectiveFrom DateTime  @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  currency  Currency  @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, currencyCode, effectiveFrom])
  @@index([tenantId, adminUserId, effectiveTo])
  @@index([tenantId])
  @@map("admin_approval_limits")
}

// =============================================================================
// DEPOSITS
// =============================================================================

model DepositRequest {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  /// Human-facing reference (Crockford base32, 10 chars). Shown to the player, printed on the admin
  /// card, and sent as the Ichancy `comment` — the only breadcrumb visible in their panel.
  shortId  String @map("short_id")

  playerId             String  @map("player_id") @db.Uuid
  paymentMethodId      String  @map("payment_method_id") @db.Uuid
  paymentDestinationId String? @map("payment_destination_id") @db.Uuid
  currencyCode         String  @map("currency_code") @db.VarChar(3)

  /// What the player says they sent. NEVER overwritten.
  claimedAmountMinor  BigInt  @map("claimed_amount_minor")
  /// What an admin/statement actually confirmed. Null until verified; may differ from the claim.
  verifiedAmountMinor BigInt? @map("verified_amount_minor")
  feeMinor            BigInt  @default(0) @map("fee_minor")
  /// What we actually asked Ichancy to credit (verified - fee). Kept separately so a later fee
  /// policy change cannot retro-explain an old credit.
  creditedAmountMinor BigInt? @map("credited_amount_minor")

  status DepositStatus @default(DRAFT)

  /// The rail's own reference typed by the player. Uniqueness is partial (see prisma/sql/004):
  /// unique per payment method while the deposit is not REJECTED.
  externalReference String? @map("external_reference")
  /// Sender account/number as claimed, used to spot mismatched senders.
  senderAccount     String? @map("sender_account")

  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(6)
  submittedAt      DateTime? @map("submitted_at") @db.Timestamptz(6)
  reviewStartedAt  DateTime? @map("review_started_at") @db.Timestamptz(6)
  decidedAt        DateTime? @map("decided_at") @db.Timestamptz(6)
  secondApprovedAt DateTime? @map("second_approved_at") @db.Timestamptz(6)
  creditedAt       DateTime? @map("credited_at") @db.Timestamptz(6)

  decidedByAdminId      String? @map("decided_by_admin_id") @db.Uuid
  /// Four-eyes: must differ from decidedByAdminId (CHECK constraint, prisma/sql/005).
  secondApproverAdminId String? @map("second_approver_admin_id") @db.Uuid

  rejectionCode RejectionCode? @map("rejection_code")
  rejectionNote String?        @map("rejection_note")

  /// Client-supplied idempotency key for the CREATE call, so a retried mini-app POST does not
  /// open a second deposit.
  idempotencyKey String? @map("idempotency_key")
  /// Bumped every time an admin deliberately re-runs the credit. It is part of the BullMQ job id
  /// and of the per-player Redis mutex key, so a stale worker cannot resurrect an old attempt.
  creditKeyEpoch Int     @default(0) @map("credit_key_epoch")
  creditAttempts Int     @default(0) @map("credit_attempts")

  creditVerifiedBy   CreditVerifiedBy? @map("credit_verified_by")
  /// Ichancy player balance read immediately BEFORE the credit call (b0).
  balanceBeforeMinor BigInt?           @map("balance_before_minor")
  /// Balance read after an ambiguous call (b1). (b1 - b0) >= amount proves the credit landed.
  balanceAfterMinor  BigInt?           @map("balance_after_minor")

  /// T1 (claim) and T2 (credit) pointers. Unique so a ledger transaction can back at most one
  /// deposit in each role.
  ledgerClaimTxId  String? @unique @map("ledger_claim_tx_id") @db.Uuid
  ledgerCreditTxId String? @unique @map("ledger_credit_tx_id") @db.Uuid

  /// Where the review card lives, so the worker can edit the exact message later.
  adminChatId    BigInt? @map("admin_chat_id")
  adminMessageId BigInt? @map("admin_message_id")
  adminThreadId  BigInt? @map("admin_thread_id")

  source    String? @db.VarChar(32)
  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  player              Player              @relation(fields: [playerId], references: [id], onDelete: Restrict)
  paymentMethod       PaymentMethod       @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  paymentDestination  PaymentDestination? @relation(fields: [paymentDestinationId], references: [id], onDelete: Restrict)
  currency            Currency            @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  decidedByAdmin      AdminUser?          @relation("DepositDecidedBy", fields: [decidedByAdminId], references: [id], onDelete: Restrict)
  secondApproverAdmin AdminUser?          @relation("DepositSecondApprover", fields: [secondApproverAdminId], references: [id], onDelete: Restrict)
  ledgerClaimTx       LedgerTransaction?  @relation("DepositClaimTx", fields: [ledgerClaimTxId], references: [id], onDelete: Restrict)
  ledgerCreditTx      LedgerTransaction?  @relation("DepositCreditTx", fields: [ledgerCreditTxId], references: [id], onDelete: Restrict)

  proofs               DepositProof[]
  transitions          DepositTransition[]
  ichancyCalls         IchancyCall[]
  ledgerTransactions   LedgerTransaction[]   @relation("LedgerTxDeposit")
  reconciliationBreaks ReconciliationBreak[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, shortId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, playerId, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, paymentMethodId, status])
  @@index([tenantId])
  @@map("deposit_requests")
}

model DepositProof {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String      @map("tenant_id") @db.Uuid
  depositRequestId String      @map("deposit_request_id") @db.Uuid
  source           ProofSource

  /// Object storage coordinates. Files are private; the API hands out short-lived presigned URLs.
  bucket         String
  storageKey     String  @map("storage_key")
  mimeType       String  @map("mime_type")
  sizeBytes      Int     @map("size_bytes")
  /// Content hash. Same image re-used across deposits is the cheapest fraud signal we have.
  sha256         String  @db.Char(64)
  width          Int?
  height         Int?
  /// Telegram's file_id when the proof arrived through the bot rather than the mini-app.
  telegramFileId String? @map("telegram_file_id")

  uploadedByType ActorType @map("uploaded_by_type")
  uploadedById   String?   @map("uploaded_by_id") @db.Uuid

  /// Best-effort OCR, used to pre-fill the review card. Never trusted as the verified amount.
  ocrText        String? @map("ocr_text")
  ocrAmountMinor BigInt? @map("ocr_amount_minor")
  ocrReference   String? @map("ocr_reference")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  depositRequest DepositRequest @relation(fields: [depositRequestId], references: [id], onDelete: Restrict)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([depositRequestId, sha256])
  @@index([tenantId, sha256])
  @@index([tenantId])
  @@map("deposit_proofs")
}

model DepositTransition {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  depositRequestId String         @map("deposit_request_id") @db.Uuid
  /// Null only for the very first transition into DRAFT.
  fromStatus       DepositStatus? @map("from_status")
  toStatus         DepositStatus  @map("to_status")

  actorType ActorType @map("actor_type")
  actorId   String?   @map("actor_id") @db.Uuid
  reason    String?
  /// Anything that explains the move (ichancy error code, matched reference, job id).
  metadata  Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  depositRequest DepositRequest @relation(fields: [depositRequestId], references: [id], onDelete: Restrict)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, depositRequestId, createdAt])
  @@index([tenantId, toStatus, createdAt])
  @@index([tenantId])
  @@map("deposit_transitions")
}

// =============================================================================
// LEDGER (append-only, double entry)
// =============================================================================

model LedgerAccount {
  id       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String            @map("tenant_id") @db.Uuid
  /// Deterministic, human-readable identity, e.g. "PLAYER_LIABILITY:<playerId>" or
  /// "RAIL_CLEARING:SYRIATEL_CASH". Unique, so account lookup never needs a composite key.
  code     String
  kind     LedgerAccountKind
  name     String

  currencyCode    String  @map("currency_code") @db.VarChar(3)
  /// Set for the per-player accounts (PLAYER_LIABILITY, CASINO_MIRROR).
  playerId        String? @map("player_id") @db.Uuid
  /// Set for RAIL_CLEARING accounts.
  paymentMethodId String? @map("payment_method_id") @db.Uuid

  /// Sign convention for reporting: debit-normal accounts (assets) grow with positive entries.
  isDebitNormal Boolean @map("is_debit_normal")
  isActive      Boolean @default(true) @map("is_active")

  /// ADVISORY cache for fast float checks on the approval path. The entries table is the truth;
  /// a reconciliation job rewrites this from SUM(amount_minor).
  cachedBalanceMinor BigInt    @default(0) @map("cached_balance_minor")
  cachedAt           DateTime? @map("cached_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  currency             Currency              @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  player               Player?               @relation(fields: [playerId], references: [id], onDelete: Restrict)
  paymentMethod        PaymentMethod?        @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  entries              LedgerEntry[]
  reconciliationBreaks ReconciliationBreak[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, kind, currencyCode])
  @@index([tenantId, playerId, kind])
  @@index([tenantId])
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  kind         LedgerTxKind
  currencyCode String       @map("currency_code") @db.VarChar(3)

  /// When the money actually moved in the real world (may precede postedAt).
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  postedAt   DateTime @default(now()) @map("posted_at") @db.Timestamptz(6)

  description String
  actorType   ActorType @map("actor_type")
  actorId     String?   @map("actor_id") @db.Uuid

  depositRequestId String? @map("deposit_request_id") @db.Uuid
  /// Free-form external anchor (Ichancy comment, bank reference) for forensic search.
  externalRef      String? @map("external_ref")
  /// Set on a compensating transaction; the original is never edited.
  reversesTxId     String? @unique @map("reverses_tx_id") @db.Uuid
  metadata         Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  currency         Currency              @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  depositRequest   DepositRequest?       @relation("LedgerTxDeposit", fields: [depositRequestId], references: [id], onDelete: Restrict)
  reverses         LedgerTransaction?    @relation("LedgerReversal", fields: [reversesTxId], references: [id], onDelete: Restrict)
  reversedBy       LedgerTransaction?    @relation("LedgerReversal")
  claimForDeposit  DepositRequest?       @relation("DepositClaimTx")
  creditForDeposit DepositRequest?       @relation("DepositCreditTx")
  entries          LedgerEntry[]
  resolvedBreaks   ReconciliationBreak[] @relation("BreakResolutionTx")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, kind, postedAt])
  @@index([tenantId, depositRequestId])
  @@index([tenantId, postedAt])
  @@index([tenantId])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id                  String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String @map("tenant_id") @db.Uuid
  ledgerTransactionId String @map("ledger_transaction_id") @db.Uuid
  ledgerAccountId     String @map("ledger_account_id") @db.Uuid
  /// Denormalized from the account so the balance trigger can group without a join.
  currencyCode        String @map("currency_code") @db.VarChar(3)

  /// SIGNED minor units. Positive = debit, negative = credit. The sum per (transaction, currency)
  /// must be exactly 0 — enforced by a deferrable constraint trigger, not by application code.
  amountMinor BigInt  @map("amount_minor")
  /// Position within the transaction; makes entries reproducible and diffable.
  sequence    Int
  memo        String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  transaction LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)
  account     LedgerAccount     @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  currency    Currency          @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([ledgerTransactionId, sequence])
  @@index([tenantId, ledgerAccountId, createdAt])
  @@index([tenantId, ledgerTransactionId])
  @@index([tenantId])
  @@map("ledger_entries")
}

// =============================================================================
// INFRASTRUCTURE / AUDIT
// =============================================================================

model OutboxMessage {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  /// Routing key, e.g. "deposit.credit.requested" or "telegram.notify.player".
  topic         String
  payload       Json
  status        OutboxStatus @default(PENDING)

  attempts    Int       @default(0)
  /// Backoff target: the relay only picks rows whose availableAt has passed.
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  lockedAt    DateTime? @map("locked_at") @db.Timestamptz(6)
  lockedBy    String?   @map("locked_by")
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(6)
  lastError   String?   @map("last_error")
  /// Optional natural key so the same event cannot be enqueued twice from a retried transaction.
  dedupeKey   String?   @map("dedupe_key")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status, availableAt])
  @@index([tenantId, aggregateType, aggregateId])
  @@index([tenantId])
  @@map("outbox_messages")
}

model IdempotencyKey {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  /// Namespace, e.g. "deposit.create" — the same client key may exist in different scopes.
  scope       String
  key         String
  /// Hash of the request body; a replay with the SAME key but a different body is a client bug and
  /// must be rejected rather than silently answered with the old response.
  requestHash String @map("request_hash")

  /// 'IN_FLIGHT' | 'COMPLETED'. A plain string because this is infrastructure, not a domain enum.
  state        String  @default("IN_FLIGHT") @db.VarChar(16)
  /// Cached response replayed on a duplicate call.
  responseBody Json?   @map("response_body")
  /// Id of whatever was created (deposit id, ledger tx id).
  resultRef    String? @map("result_ref")

  lockedAt    DateTime  @default(now()) @map("locked_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scope, key])
  @@index([tenantId, expiresAt])
  @@index([tenantId])
  @@map("idempotency_keys")
}

model TelegramUpdate {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  /// Telegram's own update_id. UNIQUE is the entire point: webhooks are re-delivered and a replayed
  /// "approve" callback must never approve twice.
  updateId BigInt @map("update_id")

  kind       String? @db.VarChar(32)
  chatId     BigInt? @map("chat_id")
  fromUserId BigInt? @map("from_user_id")
  payload    Json

  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(6)
  handler         String?
  processingError String?   @map("processing_error")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, updateId])
  @@index([tenantId, receivedAt])
  @@index([tenantId, processedAt])
  @@index([tenantId])
  @@map("telegram_updates")
}

/// A group or channel an operator's bot was seen in. Telegram volunteers a private group's id only by
/// pushing an update (my_chat_member when the bot is added, promoted, demoted or removed), and has no
/// "list my chats" call, so every sighting is recorded here while the update is handled, for ANY
/// operator status: a new operator is SUSPENDED exactly when its bot is being added to its groups.
///
/// A row is an OBSERVATION, never a permission. Binding a chat re-asks Telegram at that moment. The
/// flags are the last sighting and may be stale; `lastSeenAt` is Telegram's own date for it, and an
/// older update never overwrites a newer one.
model TelegramDiscoveredChat {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  chatId   BigInt @map("chat_id")

  chatType        TelegramChatType      @map("chat_type")
  title           String?
  username        String?
  status          TelegramBotChatStatus
  isAdministrator Boolean               @map("is_administrator")
  /// False once the bot left or was removed. Kept, not deleted: "the bot was removed" is an answer.
  isPresent       Boolean               @map("is_present")
  canPost         Boolean               @map("can_post")

  /// Who last changed the bot's membership (my_chat_member.from). Shown so a stranger's group is
  /// recognisable before anybody binds it.
  lastChangedByTelegramUserId BigInt? @map("last_changed_by_telegram_user_id")
  lastChangedByUsername       String? @map("last_changed_by_username")
  /// Set when this group became a supergroup, which has a new id. The row it moved to is kept too.
  migratedToChatId            BigInt? @map("migrated_to_chat_id")

  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt  DateTime @map("last_seen_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, chatId])
  @@index([tenantId, lastSeenAt])
  @@index([tenantId])
  @@map("telegram_discovered_chats")
}

/// A one-time "Add bot to staff group" link issued by a PLATFORM_ADMIN. The link carries a random
/// nonce as its startgroup payload; Telegram hands it back as `/start@<bot> <nonce>` in the group the
/// bot was added to, and that is what binds the group to this operator and purpose.
///
/// ONLY A HASH OF THE NONCE IS STORED: the nonce is a bearer credential for binding a chat, and a
/// database read must not be enough to use one. One use (`usedAt`), a short expiry, and issuing a new
/// link for the same purpose revokes the previous one, so at most one is live per purpose.
model TelegramChatBindLink {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  purpose         TelegramChatPurpose
  /// sha256 of the nonce, hex.
  nonceHash       String              @unique @map("nonce_hash") @db.VarChar(64)
  /// The tenant-zero PLATFORM_ADMIN who issued it; the bind it leads to is audited as theirs.
  issuedByAdminId String              @map("issued_by_admin_id") @db.Uuid
  expiresAt       DateTime            @map("expires_at") @db.Timestamptz(6)
  usedAt          DateTime?           @map("used_at") @db.Timestamptz(6)
  usedChatId      BigInt?             @map("used_chat_id")
  /// The first chat that presented the nonce (`/start@<bot> <nonce>`), set by one conditional update.
  /// Every member of that chat can read the nonce, so the same link from any other chat is refused
  /// (LINK_OTHER_CHAT). Moves with the chat when it becomes a supergroup. Null: not presented yet.
  pinnedChatId    BigInt?             @map("pinned_chat_id")
  revokedAt       DateTime?           @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, purpose, createdAt])
  @@index([tenantId])
  @@map("telegram_chat_bind_links")
}

/// A one-time code that links a staff account to a Telegram account (owner decision 4, 2026-09-15).
/// The console shows the code; the staff member sends `/link <code>` to the operator's bot in a
/// private chat, and the Telegram id of that update's sender becomes the account's `telegramUserId`.
/// That is the only way the column is set: the staff directory still refuses it on create and update.
///
/// ONLY A KEYED DIGEST OF THE CODE IS STORED: HMAC-SHA256 under a key derived from JWT_SECRET, over
/// the operator id and the code. The code is short enough to type, so a plain hash would fall to a
/// brute force from a database dump inside its lifetime; without the key a dump holds nothing usable.
/// The operator is inside the digest, so a code only exists for the operator that issued it.
/// One use (`usedAt`), a short expiry, and issuing a new code for an account revokes the previous one,
/// so at most one is live per staff account.
model AdminTelegramLinkCode {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  /// The staff account the code links.
  adminUserId          String    @map("admin_user_id") @db.Uuid
  /// HMAC-SHA256 hex, see the model comment.
  codeDigest           String    @unique @map("code_digest") @db.VarChar(64)
  /// Who asked the console for it: the staff member, or a platform admin on their behalf.
  issuedByAdminId      String    @map("issued_by_admin_id") @db.Uuid
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt               DateTime? @map("used_at") @db.Timestamptz(6)
  usedByTelegramUserId BigInt?   @map("used_by_telegram_user_id")
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, adminUserId, createdAt])
  @@index([tenantId])
  @@map("admin_telegram_link_codes")
}

model IchancyCall {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  operation IchancyOperation
  /// 1-based attempt counter within one logical operation (refresh+retry produces attempt 2).
  attempt   Int              @default(1)

  /// Nullable because a transport failure/timeout never produced a status code.
  httpStatus   Int?           @map("http_status")
  outcome      IchancyOutcome
  /// Request as sent, with credentials/tokens redacted. This is our only forensic record.
  requestBody  Json           @map("request_body")
  responseBody Json?          @map("response_body")
  /// Normalized code (see IchancyRejectionCodes) plus the raw notification content.
  errorCode    String?        @map("error_code")
  errorMessage String?        @map("error_message")
  durationMs   Int            @map("duration_ms")

  depositRequestId String? @map("deposit_request_id") @db.Uuid
  playerId         String? @map("player_id") @db.Uuid
  /// Ties every attempt of one logical operation (and its log lines) together.
  correlationId    String? @map("correlation_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  depositRequest       DepositRequest?       @relation(fields: [depositRequestId], references: [id], onDelete: Restrict)
  player               Player?               @relation(fields: [playerId], references: [id], onDelete: Restrict)
  reconciliationBreaks ReconciliationBreak[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, operation, createdAt])
  @@index([tenantId, depositRequestId, createdAt])
  @@index([tenantId, outcome, createdAt])
  @@index([tenantId, correlationId])
  @@index([tenantId])
  @@map("ichancy_calls")
}

model AuditLog {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  actorType ActorType @map("actor_type")
  /// Null for SYSTEM. Not a foreign key: the actor may be a player, an admin, or nobody.
  actorId   String?   @map("actor_id") @db.Uuid

  /// Stable verb, e.g. "deposit.approve", "admin.limit.update".
  action     String
  entityType String @map("entity_type")
  entityId   String @map("entity_id")

  /// Field-level snapshots. Written by the service, never mutated afterwards (immutability trigger).
  before Json?
  after  Json?

  ip            String? @db.Inet
  userAgent     String? @map("user_agent")
  correlationId String? @map("correlation_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId, createdAt])
  @@index([tenantId, actorType, actorId, createdAt])
  @@index([tenantId, action, createdAt])
  @@index([tenantId])
  @@map("audit_logs")
}

model ReconciliationBreak {
  id       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String        @map("tenant_id") @db.Uuid
  category BreakCategory
  status   BreakStatus   @default(OPEN)
  /// 1 = informational, 5 = money is missing right now.
  severity Int           @default(3)

  currencyCode  String  @map("currency_code") @db.VarChar(3)
  expectedMinor BigInt? @map("expected_minor")
  actualMinor   BigInt? @map("actual_minor")
  deltaMinor    BigInt? @map("delta_minor")

  depositRequestId String? @map("deposit_request_id") @db.Uuid
  playerId         String? @map("player_id") @db.Uuid
  ledgerAccountId  String? @map("ledger_account_id") @db.Uuid
  ichancyCallId    String? @map("ichancy_call_id") @db.Uuid

  detail    Json?
  /// Stable natural key of the finding so a cron re-run updates instead of duplicating.
  dedupeKey String? @map("dedupe_key")

  detectedAt        DateTime  @default(now()) @map("detected_at") @db.Timestamptz(6)
  assignedToAdminId String?   @map("assigned_to_admin_id") @db.Uuid
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedByAdminId String?   @map("resolved_by_admin_id") @db.Uuid
  resolutionNote    String?   @map("resolution_note")
  /// The compensating ledger transaction that closed this break, if any.
  resolutionTxId    String?   @map("resolution_tx_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  currency        Currency           @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  depositRequest  DepositRequest?    @relation(fields: [depositRequestId], references: [id], onDelete: Restrict)
  player          Player?            @relation(fields: [playerId], references: [id], onDelete: Restrict)
  ledgerAccount   LedgerAccount?     @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  ichancyCall     IchancyCall?       @relation(fields: [ichancyCallId], references: [id], onDelete: Restrict)
  assignedToAdmin AdminUser?         @relation("BreakAssignee", fields: [assignedToAdminId], references: [id], onDelete: Restrict)
  resolvedByAdmin AdminUser?         @relation("BreakResolver", fields: [resolvedByAdminId], references: [id], onDelete: Restrict)
  resolutionTx    LedgerTransaction? @relation("BreakResolutionTx", fields: [resolutionTxId], references: [id], onDelete: Restrict)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status, detectedAt])
  @@index([tenantId, category, status])
  @@index([tenantId, depositRequestId])
  @@index([tenantId])
  @@map("reconciliation_breaks")
}

// =============================================================================
// RESPONSIBLE GAMING
// =============================================================================

model PlayerLimit {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  playerId     String @map("player_id") @db.Uuid
  currencyCode String @map("currency_code") @db.VarChar(3)

  dailyDepositCapMinor   BigInt? @map("daily_deposit_cap_minor")
  weeklyDepositCapMinor  BigInt? @map("weekly_deposit_cap_minor")
  monthlyDepositCapMinor BigInt? @map("monthly_deposit_cap_minor")
  maxSingleDepositMinor  BigInt? @map("max_single_deposit_minor")
  /// Minimum gap between two deposits; blunt anti-chasing tool.
  cooldownMinutes        Int?    @map("cooldown_minutes")

  setByType ActorType @map("set_by_type")
  setById   String?   @map("set_by_id") @db.Uuid

  /// Versioned like admin limits: a tightening applies immediately, a loosening can be scheduled.
  effectiveFrom DateTime  @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  player   Player   @relation(fields: [playerId], references: [id], onDelete: Restrict)
  currency Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([playerId, currencyCode, effectiveFrom])
  @@index([tenantId, playerId, effectiveTo])
  @@index([tenantId])
  @@map("player_limits")
}

model SelfExclusion {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  playerId String @map("player_id") @db.Uuid

  startsAt DateTime  @default(now()) @map("starts_at") @db.Timestamptz(6)
  /// Null = permanent. A permanent exclusion can only be lifted by an admin, never by the player.
  endsAt   DateTime? @map("ends_at") @db.Timestamptz(6)
  reason   String?

  requestedByType ActorType @map("requested_by_type")
  requestedById   String?   @map("requested_by_id") @db.Uuid

  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedByAdminId String?   @map("revoked_by_admin_id") @db.Uuid
  revocationReason String?   @map("revocation_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  player         Player     @relation(fields: [playerId], references: [id], onDelete: Restrict)
  revokedByAdmin AdminUser? @relation("SelfExclusionRevoker", fields: [revokedByAdminId], references: [id], onDelete: Restrict)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, playerId, startsAt])
  @@index([tenantId, endsAt])
  @@index([tenantId])
  @@map("self_exclusions")
}
